# Training Data
fever = [1, 1, 0, 1, 0]
headache = [1, 0, 1, 1, 0]
disease = ["Yes", "Yes", "No", "Yes", "No"]

# Prior Probabilities
yes = disease.count("Yes")
no = disease.count("No")

P_yes = yes / len(disease)
P_no = no / len(disease)

# Conditional Probabilities
P_fever_yes = 3 / 3
P_headache_yes = 1 / 3

P_fever_no = 0 / 2
P_headache_no = 1 / 2

# New Patient 
prob_yes = P_yes * P_fever_yes * P_headache_yes
prob_no = P_no * P_fever_no * P_headache_no

print("P(Yes) =", prob_yes)
print("P(No) =", prob_no)

if prob_yes > prob_no:
    print("Disease = Yes")
else:
    print("Disease = No")
